# Copy this file to ".env" and edit. Relative paths are relative to the backend/ folder.
MODEL_PATH=models/best.pt
METADATA_PATH=models/model_metadata.json

# Detection thresholds (can be overridden per request)
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.7
IMAGE_SIZE=640

# Upload limits
MAX_UPLOAD_MB=10
MAX_IMAGE_PIXELS=50000000

# "cpu" or a GPU index such as "0"
DEVICE=cpu
